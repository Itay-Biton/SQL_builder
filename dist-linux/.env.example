# ============================================
# SQL BUILDER - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and configure with your settings

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Server Port (the application will run on this port)
PORT=3000

# MySQL Connection Details
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sqlbuilder
MYSQL_USER=sqlbuilder_user
MYSQL_PASSWORD=change_user_password

# MySQL Connection Security
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Security - JWT Token Secret
# IMPORTANT: Change this to a strong random string (minimum 32 characters)
JWT_SECRET=change_this_to_a_strong_random_secret_minimum_32_characters

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# JWT Token Expiration (default: 24h)
JWT_EXPIRATION=24h

# Database Connection Retry Settings
DB_CONNECTION_RETRY_COUNT=3
DB_CONNECTION_RETRY_DELAY_MS=2000

# MySQL Connection Pool Settings (optional - uses defaults if not specified)
# MYSQL_CONNECTION_TIMEOUT=15000
# MYSQL_POOL_MAX=10

# File Paths (relative to executable location)
USERS_FILE_PATH=./users.json
SCHEMA_CACHE_PATH=./schema_cache.json
LOG_DIR=./logs

# Logging Configuration
LOG_RETENTION_DAYS=30
COMPRESSION_THRESHOLD_DAYS=1
